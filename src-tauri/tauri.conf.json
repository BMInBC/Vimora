{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Vimora",
    "version":  "1.0.0",
    "identifier":  "com.vimora.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:3000",
                  "beforeBuildCommand":  "npm run build:export",
                  "frontendDist":  "../out"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Vimora - Private GPU Media Converter",
                                    "width":  1280,
                                    "height":  860,
                                    "minWidth":  960,
                                    "minHeight":  640,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "plugins":  {
                    "dialog":  {

                               },
                    "fs":  {

                           },
                    "shell":  {
                                  "open":  true
                              }
                },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico",
            "icons/icon.png",
            "icons/icon.icns"
        ]
    }
}